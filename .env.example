# Copy to .env and fill in. Every name here is read only by
# src/common/config/env.ts — nothing else in the codebase touches process.env.
# On boot the app logs which of these are set and which are missing.

NODE_ENV=development
PORT=4000

# The process runs in UTC. env.ts sets TZ=UTC before anything else loads,
# and the Postgres session is opened with `-c timezone=UTC`.

# --- Database -----------------------------------------------------------
# Neon Postgres. DATABASE_URL wins when set; the DB_* vars are for local runs.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=coinzu
DB_SSL=true

# --- Auth ---------------------------------------------------------------
# Shared with rewardtym-backend. The same JWT_AUTH_TOKEN verifies both a
# Coinzu user token and a Rewardtym admin token, so use rewardtym's values.
JWT_AUTH_TOKEN=
JWT_REFRESH_TOKEN=
JWT_EXPIRES_IN=150000m
JWT_REFRESH_EXPIRES_IN=7d

# Fallback only. A Rewardtym admin token now carries a `product_access` claim
# (both | rewardtym | coinzu) and Coinzu lets `both` and `coinzu` through. This
# list is used only for tokens issued before that claim existed: their `role`
# claim must appear here. Comma-separated. Coinzu has no admin table.
ADMIN_ROLES=super_admin,coinzu_admin

# 32-byte key for AES-256-GCM. Encrypts withdrawal destinations, gift card
# codes and provider secrets. Changing it makes existing rows unreadable.
ENCRYPTION_KEY=

# --- Redis (rewardtym instance) -----------------------------------------
# Used for OTP throttling and short-lived caches. Off by default; the app
# runs fine without it. Point these at the same Redis rewardtym uses.
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=coinzu:

# --- Cloudflare R2 (rewardtym bucket) -----------------------------------
# Avatars and KYC selfies. Same credentials as rewardtym-backend.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_MAX_FILE_BYTES=5242880

# --- Google sign-in -----------------------------------------------------
# Web client ID that issues the ID token the app sends to POST /auth/google.
GOOGLE_CLIENT_ID=

# --- AWS ----------------------------------------------------------------
# Rekognition only, for the KYC selfie check. No SES, no SNS.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Transactional email (SendGrid) -------------------------------------
# Same SendGrid account as Rewardtym. The from address must be a verified
# sender on that account — it is not a free-text field.
SENDGRID_API_KEY=
SENDGRID_FROM_ADDRESS=no-reply@rewardtym.online
SENDGRID_FROM_NAME=Coinzu
SENDGRID_REPLY_TO=prashant@rewardtym.online

# --- Gift card vendor ---------------------------------------------------
GIFT_CARD_API_URL=
GIFT_CARD_API_KEY=
GIFT_CARD_PROVIDER_NAME=default

# --- One-time passcodes -------------------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Email verification links and forgot-password links, opened in the browser.
LINK_TOKEN_TTL_MINUTES=30

# --- URLs and CORS ------------------------------------------------------
# CORS_ORIGINS is comma-separated. NOTE: empty does NOT allow every origin --
# it just leaves the allowlist as FRONTEND_URL (+ localhost outside production).
# CORS currently allows ALL origins via a temporary override in src/main.ts.
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=

# --- Rate limiting ------------------------------------------------------
# Requests per TTL window, per IP.
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# --- Push notifications (Firebase Cloud Messaging) ----------------------
# From a Firebase service-account JSON: Project settings > Service accounts >
# Generate new private key. Leave all three blank and every send is a dry run —
# the audience is resolved and in-app copies are written, but nothing is
# delivered to a device.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n escapes and wrap the whole value in double quotes.
FIREBASE_PRIVATE_KEY=
